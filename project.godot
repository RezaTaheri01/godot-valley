[application]

config/name="StardewValley"
run/main_scene="uid://dkaf0otbgtrp5"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://ci8u0m7y1ts8a"

[autoload]

